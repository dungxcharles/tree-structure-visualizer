                     </padding>
                  </Label>
                  <ImageView fx:id="MainMenuController" fitHeight="96.0" fitWidth="138.0" onMouseClicked="#startButtonClicked" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../images/mainmenu/start.png" />
                     </image>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
               </children>
            </VBox>
         </center>
      </BorderPane>
   </children>
</StackPane>
