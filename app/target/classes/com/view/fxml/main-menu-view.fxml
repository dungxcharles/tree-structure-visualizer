<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.GaussianBlur?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.mainmenu.MainMenuController">
   <children>
      <ImageView fitHeight="${rootPane.height}" fitWidth="${rootPane.width}" pickOnBounds="true">
         <image>
            <Image url="@../images/mainmenu/main-menu-background.png" />
         </image>
         <effect>
            <GaussianBlur radius="50.0" />
         </effect>
      </ImageView>
      <Label style="-fx-effect: dropshadow(gaussian, rgba(0,255,255,0.6), 15, 0.4, 0, 0);;" text="TREE VISUALIZATION" textAlignment="CENTER" textFill="LIGHTCYAN">
         <font>
            <Font name="JetBrainsMono NF Bold" size="67.0" />
         </font>
         <StackPane.margin>
            <Insets top="-200.0" />
         </StackPane.margin>
      </Label>
      <BorderPane prefHeight="200.0" prefWidth="200.0">
         <top>
            <HBox alignment="TOP_RIGHT" prefHeight="100.0" prefWidth="200.0" BorderPane.alignment="CENTER">
               <children>
                  <ImageView fitHeight="44.0" fitWidth="78.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#settingsButtonClicked">
                     <image>
                        <Image url="@../images/mainmenu/settings.png" />
                     </image>
                     <HBox.margin>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </HBox.margin>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
                  <ImageView fitHeight="46.0" fitWidth="56.0" pickOnBounds="true" preserveRatio="true" onMouseClicked="#helpButtonClicked">
                     <image>
                        <Image url="@../images/mainmenu/help.png" />
                     </image>
                     <HBox.margin>
                        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                     </HBox.margin>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
               </children>
               <BorderPane.margin>
                  <Insets />
               </BorderPane.margin>
            </HBox>
         </top>
         <center>
            <VBox alignment="CENTER" prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER">
               <children>
                  <Region prefHeight="108.0" prefWidth="1270.0" />
                  <Label text="Understanding Tree Structures!" textFill="WHITE">
                     <font>
                        <Font name="JetBrainsMono NF Regular" size="25.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                     <padding>
