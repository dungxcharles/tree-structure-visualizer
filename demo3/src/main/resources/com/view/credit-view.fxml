<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.credits.CreditWindow">
    
    <!-- Top Bar: Back Button -->
    <top>
        <AnchorPane prefHeight="50.0">
            <Button fx:id="btnBack" layoutX="15.0" layoutY="10.0" onAction="#handleBack" style="-fx-background-color: transparent; -fx-cursor: hand;" text="⬅Back">
                <font>
                    <Font size="18.0" />
                </font>
            </Button>
        </AnchorPane>
    </top>

    <!-- Left Navigation Button -->
    <left>
        <StackPane alignment="CENTER" prefWidth="60.0">
            <Button fx:id="btnLeft" onAction="#handleLeft" prefHeight="100.0" prefWidth="40.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="❮">
                <font>
                    <Font size="40.0" />
                </font>
            </Button>
        </StackPane>
    </left>

    <!-- Center Content Area: Swaps pages -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </StackPane>
    </center>

    <!-- Right Navigation Button -->
    <right>
        <StackPane alignment="CENTER" prefWidth="60.0">
            <Button fx:id="btnRight" onAction="#handleRight" prefHeight="100.0" prefWidth="40.0" style="-fx-background-color: transparent; -fx-cursor: hand;" text="❯">
                <font>
                    <Font size="40.0" />
                </font>
            </Button>
        </StackPane>
    </right>

    <!-- Bottom: Pagination Indicators -->
    <bottom>
        <HBox fx:id="paginationDots" alignment="CENTER" prefHeight="60.0" spacing="10.0">
            <padding>
                <Insets bottom="20.0" top="10.0" />
            </padding>
        </HBox>
    </bottom>

</BorderPane>
