<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" stylesheets="@workspace.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.workspace.WorkspaceController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="top-bar">
            <Button fx:id="homeButton" onMouseClicked="#homeButtonClicked" styleClass="home-button" text="Home" />
            <Separator orientation="VERTICAL" />
            <Label style="-fx-font-weight: bold; -fx-text-fill: #5f6368;" text="Tree Type:" />
            <ComboBox fx:id="treeTypeComboBox" prefWidth="180.0" promptText="Select Tree Type" styleClass="tree-type-combo" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background-color: transparent; -fx-background: #f0f2f5;">
            <Pane fx:id="visualizerPane" prefHeight="2000.0" prefWidth="2000.0" styleClass="canvas-container" />
        </ScrollPane>
    </center>

    <right>
        <VBox prefWidth="320.0" styleClass="right-panel">
            <Label styleClass="panel-title" text="Pseudo Code" />
            <ListView fx:id="pseudoCodeListView" prefHeight="260.0" styleClass="pseudo-code-list" VBox.vgrow="NEVER" />
            
            <Separator />
            
            <Label styleClass="panel-title" text="Tree Statistics" />
            <GridPane styleClass="stats-grid">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="130.0" />
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                </rowConstraints>
                <children>
                    <Label styleClass="stats-label" text="Tree type:" />
                    <Label fx:id="treeTypeLabel" styleClass="stats-value" text="null" GridPane.columnIndex="1" />
                    <Label styleClass="stats-label" text="Height:" GridPane.rowIndex="1" />
                    <Label fx:id="heightLabel" styleClass="stats-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                    <Label styleClass="stats-label" text="Number of nodes:" GridPane.rowIndex="2" />
                    <Label fx:id="numNodesLabel" styleClass="stats-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    <Label styleClass="stats-label" text="Root value:" GridPane.rowIndex="3" />
                    <Label fx:id="rootValueLabel" styleClass="stats-value" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                </children>
            </GridPane>
        </VBox>
    </right>

    <bottom>
        <HBox styleClass="bottom-bar">
            <TextField fx:id="parentValueTextField" managed="false" prefWidth="70.0" promptText="Parent" styleClass="input-field" visible="false" />
            <TextField fx:id="valueTextField" prefWidth="80.0" promptText="Value" styleClass="input-field" />
            
            <Button fx:id="insertButton" onAction="#handleInsertAction" styleClass="action-btn, btn-insert" text="Insert" />
            <Button fx:id="deleteButton" onAction="#handleDeleteAction" styleClass="action-btn, btn-delete" text="Delete" />
            <Button fx:id="searchButton" onAction="#handleSearchAction" styleClass="action-btn, btn-search" text="Search" />
            
            <Separator orientation="VERTICAL" />
            
            <Button fx:id="undoButton" onAction="#handleUndoAction" styleClass="action-btn" text="Undo" disable="true" />
            <Button fx:id="redoButton" onAction="#handleRedoAction" styleClass="action-btn" text="Redo" disable="true" />
            
            <Separator orientation="VERTICAL" />
            
            <Button fx:id="pauseResumeButton" onAction="#handlePauseResumeAction" styleClass="action-btn, btn-pause" text="Pause" />
            
            <Separator orientation="VERTICAL" />
            
            <Label style="-fx-font-weight: bold; -fx-text-fill: #5f6368;" text="Traverse:" />
            <ComboBox fx:id="traversalComboBox" prefWidth="140.0" promptText="Select Type" styleClass="input-field" />
            
            <Pane HBox.hgrow="ALWAYS" /> <!-- Spacer -->
            
            <Label style="-fx-font-weight: bold; -fx-text-fill: #5f6368;" text="Speed:" />
            <Slider fx:id="speedSlider" majorTickUnit="0.5" max="1.5" min="0.5" minorTickCount="4" showTickLabels="true" showTickMarks="true" styleClass="slider" value="1.0" />
        </HBox>
    </bottom>

</BorderPane>
