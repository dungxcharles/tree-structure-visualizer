<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.controller.workspace.WorkspaceController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 1 0; -fx-background-color: #f8f9fa;">
            <padding>
                <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
            </padding>
            <Button fx:id="homeButton" onMouseClicked="#homeButtonClicked" text="Home" />
            <Label text="Tree Type:" />
         <ComboBox fx:id="treeTypeComboBox" promptText="Select Tree Type" />
        </HBox>
    </top>

    <center>
        <ScrollPane fitToHeight="true" fitToWidth="true" pannable="true" style="-fx-background-color: white;">
            <Pane fx:id="visualizerPane" prefHeight="2000.0" prefWidth="2000.0" style="-fx-background-color: white;" />
        </ScrollPane>
    </center>

    <right>
        <VBox prefWidth="300.0" spacing="5.0" style="-fx-border-color: #cccccc; -fx-border-width: 0 0 0 1;">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </padding>
            <Label style="-fx-font-weight: bold;" text="Pseudo code" />
            <ListView fx:id="pseudoCodeListView" prefHeight="242.0" prefWidth="279.0" VBox.vgrow="NEVER" />
         <Label text="Tree's statistics">
            <font>
               <Font name="System Bold" size="13.0" />
            </font>
         </Label>
         <GridPane>
           <columnConstraints>
             <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
             <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
           </columnConstraints>
           <rowConstraints>
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
             <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
               <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
           </rowConstraints>
            <children>
               <Label text="Height:" GridPane.rowIndex="1" />
               <Label text="Number of nodes:" GridPane.rowIndex="2" />
               <Label text="Root value:" GridPane.rowIndex="3" />
               <Label fx:id="heightLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
               <Label fx:id="numNodesLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
               <Label fx:id="rootValueLabel" text="0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               <Label text="Tree type:" />
               <Label fx:id="treeTypeLabel" text="null" GridPane.columnIndex="1" />
            </children>
         </GridPane>
        </VBox>
    </right>

    <bottom>
        <VBox style="-fx-border-color: #cccccc; -fx-border-width: 1 0 0 0; -fx-background-color: #ffffff;">
            <!-- Operation toolbar -->
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                
                <TextField fx:id="parentValueTextField" managed="false" prefWidth="60.0" promptText="Parent" visible="false" />
                <TextField fx:id="valueTextField" prefWidth="60.0" promptText="Value" />
                <Button fx:id="insertButton" onAction="#handleInsertAction" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold;" text="Insert" />
                <Button fx:id="deleteButton" onAction="#handleDeleteAction" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Delete" />
                <Button fx:id="searchButton" onAction="#handleSearchAction" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Search" />
                
                <Button text="&lt;&lt;" />
                <Button text="Replay" />
                <Button text="&gt;&gt;" />
                
                <Separator orientation="VERTICAL" />
                
                <Label text="Traverse" />
                <ComboBox prefWidth="120.0" />
                
                <Label text="Speed:" />
                <Slider value="50.0" />
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
